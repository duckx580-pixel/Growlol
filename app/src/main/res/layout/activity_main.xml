<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/rootContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
<LinearLayout android:id="@+id/splashContent" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="32dp">
<ImageView android:id="@+id/splashLogo" android:layout_width="140dp" android:layout_height="140dp" android:contentDescription="Growlauncher logo" android:src="@drawable/growlauncher_logo" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:letterSpacing="0.20" android:text="GROWLAUNCHER" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="PRO · Ultimate Edition" android:textColor="@color/text_secondary" android:textSize="13sp" />
<TextView android:id="@+id/welcomeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Initializing experience..." android:textColor="@color/text_muted" android:textSize="12sp" />
<ProgressBar android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="28dp" android:indeterminateTint="@color/accent" />
</LinearLayout>
<ScrollView android:id="@+id/mainContent" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0" android:clipToPadding="false" android:fillViewport="true" android:paddingBottom="28dp" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/versionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="v5.54" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold" />
<TextView android:id="@+id/headerTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="GrowLauncher Pro" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Professional Game Launcher" android:textColor="@color/text_secondary" android:textSize="12sp" />
</LinearLayout>
<androidx.cardview.widget.CardView android:id="@+id/btnSwitchVersion" android:layout_width="112dp" android:layout_height="58dp" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/accent" app:cardCornerRadius="18dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="10dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻" android:textColor="@color/white" android:textSize="25sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="Switch\nVersion" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" /></LinearLayout></androidx.cardview.widget.CardView>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quick Actions" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/accountStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/pill_accent" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:text="Guest mode" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold" /></LinearLayout>
<GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:columnCount="3" android:rowCount="2">
<androidx.cardview.widget.CardView android:id="@+id/btnLaunch" android:layout_width="0dp" android:layout_height="124dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/card_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp"><include layout="@layout/tile_launch" /></androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:id="@+id/btnScriptHub" android:layout_width="0dp" android:layout_height="124dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/card_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp"><include layout="@layout/tile_script" /></androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:id="@+id/btnSetting" android:layout_width="0dp" android:layout_height="124dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/card_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp"><include layout="@layout/tile_setting" /></androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:id="@+id/btnLuaManager" android:layout_width="0dp" android:layout_height="124dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/card_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp"><include layout="@layout/tile_lua" /></androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:id="@+id/btnSound" android:layout_width="0dp" android:layout_height="124dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/card_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp"><include layout="@layout/tile_sound" /></androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:id="@+id/btnTheme" android:layout_width="0dp" android:layout_height="124dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/card_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp"><include layout="@layout/tile_theme" /></androidx.cardview.widget.CardView>
</GridLayout>
<androidx.cardview.widget.CardView android:id="@+id/runtimeCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="@color/runtime_surface" app:cardCornerRadius="20dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/runtimeTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Library Runtime" android:textColor="@color/accent" android:textSize="18sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Runtime library · patches active" android:textColor="@color/text_secondary" android:textSize="11sp" /></LinearLayout><TextView android:id="@+id/runtimeBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/pill_accent" android:paddingHorizontal="11dp" android:paddingVertical="6dp" android:text="Installed" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal"><TextView android:id="@+id/runtimeStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="● Online · 24 ms" android:textColor="@color/success" android:textSize="11sp" android:textStyle="bold" /><TextView android:id="@+id/runtimeVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Core 2.8.1" android:textColor="@color/text_muted" android:textSize="11sp" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="22dp" android:text="Growlauncher PRO  •  Ultimate Edition" android:textColor="@color/text_muted" android:textSize="10sp" />
</LinearLayout></ScrollView></FrameLayout>
